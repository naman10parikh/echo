{
  "name": "@energy/echo",
  "version": "0.1.0",
  "description": "Rate-limiting / caching domain-expert employee for the Energy fleet — correct, tested, costed limiters & caches.",
  "type": "module",
  "author": "Energy Platform",
  "repository": {
    "type": "git",
    "url": "https://github.com/naman10parikh/echo.git"
  },
  "bin": {
    "echo": "dist/cli.js"
  },
  "main": "dist/cli.js",
  "types": "dist/cli.d.ts",
  "files": [
    "dist/",
    "brain/",
    "skills/",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "brain:index": "node dist/scripts/build-brain-index.js",
    "test": "vitest run",
    "test:acceptance": "vitest run test/acceptance",
    "test:acceptance:limiter": "vitest run test/acceptance/limiter.test.ts",
    "test:acceptance:cache": "vitest run test/acceptance/cache.test.ts",
    "eval": "node dist/eval/golden/run.js",
    "prepublishOnly": "pnpm build && pnpm test"
  },
  "keywords": [
    "ai",
    "claude",
    "agent",
    "rate-limiting",
    "caching",
    "upstash",
    "redis",
    "idempotency",
    "energy"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "chalk": "^5.3.0",
    "commander": "^12.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.9"
  }
}
