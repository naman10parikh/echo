# wikimem
.wikimem-cache/
node_modules/

# build output (tsc) + generated BM25 brain-index cache (reproducible: pnpm build && pnpm run brain:index)
dist/
brain/.brain-index.json

# Observability run log (append-only runtime trace — E2/C10; the logs/ dir is tracked via .gitkeep, the data is not)
logs/runs.jsonl

# RSI engine generated output (drift proposals + run report — uploaded as a CI artifact, never source)
workflows/proposals/
rsi-report.txt

# Cockpit E2E screenshots (Cluster G2 — generated by `pnpm test:e2e`, machine-specific test output, never source)
test/e2e/screenshots/

# WikiMem test vault personal data
my-wiki/raw/
tools/agentgrid/app/release/

packages/web/.next/
*.pack

# macOS metadata
**/.DS_Store

# Ephemeral harness state (never commit)
.claude/worktrees/
.claude/backups/
.claude/scheduled_tasks.lock
.claude/vp-signals/*.done
.claude/vp-signals/*.needs-qa
.claude/vp-signals/*.migrating

# Obsidian temp files
vault/Untitled*.base

.env
